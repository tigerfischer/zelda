# Google Places API key — used for the Places API (New).
# Create in GCP Console > APIs & Services > Credentials > Create credentials > API Key
# In the same GCP project, enable: "Places API (New)". Billing must be enabled.
GOOGLE_PLACES_API_KEY=

# Google service account JSON — used for Drive + Sheets writes.
# Path is relative to the project root.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Drive folder ID where Zelda sheets and artifacts will be written.
GOOGLE_DRIVE_FOLDER_ID=1pKYT89-ojT5UEjFCbox3OyYJ6hC8DqGo

# Optional overrides (defaults shown).
# DATA_DIR=./data
# DB_PATH=./data/zelda.db
# RAW_ARTIFACTS_DIR=./data/raw-artifacts
