# Anthropic API key — used for cross-source matching (LLM Proposer + Reviewer + Synthesis).
# Create at console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=

# Google Places API key — used for the Places API (New).
# Create in GCP Console > APIs & Services > Credentials > Create credentials > API Key
# In the same GCP project, enable: "Places API (New)". Billing must be enabled.
GOOGLE_PLACES_API_KEY=

# Drive folder ID where Zelda sheets and artifacts will be written.
GOOGLE_DRIVE_FOLDER_ID=1pKYT89-ojT5UEjFCbox3OyYJ6hC8DqGo

# OAuth user credentials for Drive + Sheets (paths are relative to project root).
# Files end up in your personal Drive, charged against your free 15 GB quota.
# Create in GCP Console > APIs & Services > Credentials > Create credentials >
# OAuth client ID > Desktop app. Save the downloaded JSON as the path below.
# The token cache is created automatically on first run; do not pre-create it.
GOOGLE_OAUTH_CLIENT_SECRETS=./secrets/oauth-client.json
GOOGLE_OAUTH_TOKEN_CACHE=./secrets/oauth-token.json

# Optional overrides (defaults shown).
# DATA_DIR=./data
# DB_PATH=./data/zelda.db
# RAW_ARTIFACTS_DIR=./data/raw-artifacts
